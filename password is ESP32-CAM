// ---------------- SD CARD STORAGE ----------------
void initSD() {
  // 1-bit mode leaves GPIO4 available for the flash LED.
  if (!SD_MMC.begin("/sdcard", true)) {
    Serial.println("SD mount failed; camera will run without SD.");
    return;
  }

  if (SD_MMC.cardType() == CARD_NONE) {
    Serial.println("No SD card detected.");
    return;
  }

  SD_MMC.mkdir("/photos");
  SD_MMC.mkdir("/timelapse");

  cardMB = (uint32_t)(SD_MMC.cardSize() / (1024ULL * 1024ULL));
  sdOK = true;

  Serial.printf("SD card ready: %u MB\n", (unsigned)cardMB);
}

bool savePhoto(const char *dir, const char *prefix,
               uint32_t n, char *name, size_t nameLen) {
  if (!sdOK || sdLock == nullptr) return false;

  camera_fb_t *fb = esp_camera_fb_get();
  if (!fb) {
    Serial.println("Camera capture failed.");
    return false;
  }

  snprintf(name, nameLen, "%s/%s_%03u_%05u.jpg",
           dir, prefix, (unsigned)bootNum, (unsigned)n);

  bool ok = false;

  if (xSemaphoreTake(sdLock, pdMS_TO_TICKS(5000)) == pdTRUE) {
    File f = SD_MMC.open(name, FILE_WRITE);

    if (f) {
      size_t written = f.write(fb->buf, fb->len);
      f.close();
      ok = (written == fb->len);
    }

    xSemaphoreGive(sdLock);
  }

  esp_camera_fb_return(fb);

  if (!ok) Serial.printf("Failed to save %s\n", name);
  return ok;
}

// ---------------- BRIGHTNESS MEASUREMENT ----------------
int measureBrightness() {
  if (!psramFound()) return -1;

  camera_fb_t *fb = esp_camera_fb_get();
  if (!fb) return -1;

  int result = -1;
  size_t pixels = (size_t)fb->width * fb->height;

  uint8_t *rgb = (uint8_t *)ps_malloc(pixels * 3);

  if (rgb) {
    if (fmt2rgb888(fb->buf, fb->len, fb->format, rgb)) {
      uint64_t sum = 0;
      uint32_t count = 0;

      // Sample every 16th pixel to reduce CPU work.
      for (size_t p = 0; p < pixels; p += 16) {
        size_t i = p * 3;
        sum += rgb[i] + rgb[i + 1] + rgb[i + 2];
        count += 3;
      }

      if (count) result = (int)(sum / count);
    }

    free(rgb);
  }

  esp_camera_fb_return(fb);
  return result;
}

// ---------------- HTTP HANDLERS ----------------
esp_err_t indexHandler(httpd_req_t *req) {
  httpd_resp_set_type(req, "text/html; charset=utf-8");
  httpd_resp_set_hdr(req, "Cache-Control", "no-store");

  if (isAuthed(req)) {
    return httpd_resp_send(req, INDEX_HTML, HTTPD_RESP_USE_STRLEN);
  }

  return httpd_resp_send(req, LOGIN_HTML, HTTPD_RESP_USE_STRLEN);
}

esp_err_t authHandler(httpd_req_t *req) {
  char out[96];
  uint32_t wait = lockRemainSec();

  int left = (int)MAX_TRIES - (int)failCount;
  if (left < 0) left = 0;

  snprintf(out, sizeof(out),
           "{\"locked\":%d,\"wait\":%u,\"left\":%d}",
           wait > 0 ? 1 : 0, (unsigned)wait, left);

  httpd_resp_set_type(req, "application/json");
  httpd_resp_set_hdr(req, "Cache-Control", "no-store");
  return httpd_resp_sendstr(req, out);
}

esp_err_t loginHandler(httpd_req_t *req) {
  httpd_resp_set_type(req, "application/json");
  httpd_resp_set_hdr(req, "Cache-Control", "no-store");

  char out[96];
  uint32_t wait = lockRemainSec();

  // Any attempt after the last allowed try starts the lock.
  if (wait == 0 && failCount >= MAX_TRIES) {
    locked = true;
    lockStart = millis();
    wait = LOCK_MS / 1000UL;
  }

  if (wait > 0) {
    snprintf(out, sizeof(out),
             "{\"ok\":0,\"locked\":1,\"wait\":%u,\"left\":0}",
             (unsigned)wait);
    httpd_resp_set_status(req, "429 Too Many Requests");
    return httpd_resp_sendstr(req, out);
  }

  char body[80];
  size_t total = req->content_len;
  size_t got = 0;
  int retries = 0;
  bool good = (total > 0 && total < sizeof(body));

  if (good) {
    while (got < total) {
      int r = httpd_req_recv(req, body + got, total - got);

      if (r == HTTPD_SOCK_ERR_TIMEOUT) {
        if (++retries > 5) {
          good = false;
          break;
        }
        continue;
      }

      if (r <= 0) {
        good = false;
        break;
      }

      got += (size_t)r;
    }
  }

  if (good) body[got] = '\0';
  else body[0] = '\0';

  if (good && passOk(body)) {
    failCount = 0;

    char tok[TOKEN_LEN + 1];
    char cookie[80];

    newSession(tok);
    snprintf(cookie, sizeof(cookie),
             "sid=%s; Path=/; HttpOnly; SameSite=Strict", tok);

    httpd_resp_set_hdr(req, "Set-Cookie", cookie);
    return httpd_resp_sendstr(req, "{\"ok\":1}");
  }

  failCount++;

  int left = (int)MAX_TRIES - (int)failCount;
  if (left < 0) left = 0;

  snprintf(out, sizeof(out),
           "{\"ok\":0,\"locked\":0,\"left\":%d}", left);

  httpd_resp_set_status(req, "401 Unauthorized");
  return httpd_resp_sendstr(req, out);
}

esp_err_t logoutHandler(httpd_req_t *req) {
  int s = findSession(req);
  if (s >= 0) sessions[s][0] = '\0';

  httpd_resp_set_type(req, "text/plain");
  httpd_resp_set_hdr(req, "Set-Cookie", "sid=; Path=/; Max-Age=0");
  return httpd_resp_sendstr(req, "OK");
}

esp_err_t captureHandler(httpd_req_t *req) {
  if (!isAuthed(req)) return deny(req);

  camera_fb_t *fb = esp_camera_fb_get();

  if (!fb) {
    httpd_resp_send_500(req);
    return ESP_FAIL;
  }

  httpd_resp_set_type(req, "image/jpeg");
  httpd_resp_set_hdr(req, "Cache-Control", "no-store");
  httpd_resp_set_hdr(req, "Content-Disposition",
                     "inline; filename=capture.jpg");

  esp_err_t res = httpd_resp_send(
    req, (const char *)fb->buf, fb->len);

  esp_camera_fb_return(fb);
  return res;
}

static const char *STREAM_CT =
  "multipart/x-mixed-replace;boundary=frame123";
static const char *STREAM_BOUNDARY = "\r\n--frame123\r\n";
static const char *STREAM_PART =
  "Content-Type: image/jpeg\r\nContent-Length: %u\r\n\r\n";

esp_err_t streamHandler(httpd_req_t *req) {
  if (!isAuthed(req)) return deny(req);

  esp_err_t res = httpd_resp_set_type(req, STREAM_CT);
  if (res != ESP_OK) return res;

  httpd_resp_set_hdr(req, "Access-Control-Allow-Origin", "*");
  httpd_resp_set_hdr(req, "Cache-Control", "no-store");

  char part[80];

  while (true) {
    camera_fb_t *fb = esp_camera_fb_get();

    if (!fb) {
      res = ESP_FAIL;
      break;
    }

    res = httpd_resp_send_chunk(
      req, STREAM_BOUNDARY, strlen(STREAM_BOUNDARY));

    if (res == ESP_OK) {
      size_t len = snprintf(part, sizeof(part), STREAM_PART,
                            (unsigned)fb->len);
      res = httpd_resp_send_chunk(req, part, len);
    }

    if (res == ESP_OK) {
      res = httpd_resp_send_chunk(
        req, (const char *)fb->buf, fb->len);
    }

    esp_camera_fb_return(fb);

    if (res != ESP_OK) break;
    vTaskDelay(1);
  }

  return res;
}

esp_err_t saveHandler(httpd_req_t *req) {
  if (!isAuthed(req)) return deny(req);

  httpd_resp_set_type(req, "text/plain");

  if (!sdOK) {
    return httpd_resp_sendstr(req, "No SD card found.");
  }

  char name[64];
  char msg[100];

  uint32_t id = ++snapNum;

  if (savePhoto("/photos", "snap", id, name, sizeof(name))) {
    snprintf(msg, sizeof(msg), "Saved photo: %s", name);
  } else {
    snprintf(msg, sizeof(msg), "Photo save failed. Check SD card.");
  }

  return httpd_resp_sendstr(req, msg);
}

esp_err_t statusHandler(httpd_req_t *req) {
  if (!isAuthed(req)) return deny(req);

  sensor_t *s = esp_camera_sensor_get();
  if (!s) {
    httpd_resp_send_500(req);
    return ESP_FAIL;
  }

  uint32_t clientCount = WiFi.softAPgetStationNum();

  char buf[600];

  snprintf(buf, sizeof(buf),
    "{\"sd\":%d,\"cardMB\":%u,\"snaps\":%u,"
    "\"tl\":%d,\"tlInterval\":%u,\"tlCount\":%u,"
    "\"lightMode\":%u,\"lightLevel\":%u,\"darkThr\":%u,"
    "\"led\":%d,\"brightness\":%d,"
    "\"framesize\":%d,\"quality\":%d,"
    "\"vflip\":%d,\"hmirror\":%d,"
    "\"heap\":%u,\"psram\":%u,\"uptime\":%u,\"clients\":%u}",
    (int)sdOK, (unsigned)cardMB, (unsigned)snapNum,
    (int)tlRunning, (unsigned)tlInterval, (unsigned)tlCount,
    (unsigned)lightMode, (unsigned)lightLevel,
    (unsigned)darkThreshold, (int)ledIsOn,
    (int)lastBrightness,
    (int)s->status.framesize, (int)s->status.quality,
    (int)s->status.vflip, (int)s->status.hmirror,
    (unsigned)ESP.getFreeHeap(),
    (unsigned)ESP.getFreePsram(),
    (unsigned)((millis() - bootMillis) / 1000UL),
    (unsigned)clientCount);

  httpd_resp_set_type(req, "application/json");
  httpd_resp_set_hdr(req, "Cache-Control", "no-store");
  return httpd_resp_sendstr(req, buf);
}

esp_err_t controlHandler(httpd_req_t *req) {
  if (!isAuthed(req)) return deny(req);

  char var[32] = "";
  char val[20] = "";

  if (!getParam(req, "var", var, sizeof(var)) ||
      !getParam(req, "val", val, sizeof(val))) {
    httpd_resp_send_err(req, HTTPD_400_BAD_REQUEST,
                        "Missing var or val");
    return ESP_FAIL;
  }

  char *end = nullptr;
  long parsed = strtol(val, &end, 10);

  if (end == val || *end != '\0') {
    httpd_resp_send_err(req, HTTPD_400_BAD_REQUEST,
                        "Invalid number");
    return ESP_FAIL;
  }

  if (parsed < -1 || parsed > 1000000) {
    httpd_resp_send_err(req, HTTPD_400_BAD_REQUEST,
                        "Value out of range");
    return ESP_FAIL;
  }

  int v = (int)parsed;
  sensor_t *s = esp_camera_sensor_get();
  if (!s) {
    httpd_resp_send_500(req);
    return ESP_FAIL;
  }

  int res = 0;
  bool persistCamera = false;
  bool persistGeneral = false;

  if (!strcmp(var, "framesize")) {
    if (v < FRAMESIZE_QVGA || v > maxFrame) res = -1;
    else {
      res = s->set_framesize(s, (framesize_t)v);
      persistCamera = true;
    }
  } else if (!strcmp(var, "quality")) {
    res = s->set_quality(s, constrain(v, 6, 40));
    persistCamera = true;
  } else if (!strcmp(var, "vflip")) {
    res = s->set_vflip(s, v ? 1 : 0);
    persistCamera = true;
  } else if (!strcmp(var, "hmirror")) {
    res = s->set_hmirror(s, v ? 1 : 0);
    persistCamera = true;
  } else if (!strcmp(var, "light_mode")) {
    lightMode = constrain(v, 0, 2);
    darkNow = false;
    lightRecheck = true;
    applyLight();
    persistGeneral = true;
  } else if (!strcmp(var, "light_level")) {
    lightLevel = constrain(v, 1, 255);
    applyLight();
    persistGeneral = true;
  } else if (!strcmp(var, "dark_thr")) {
    darkThreshold = constrain(v, 5, 120);
    lightRecheck = true;
    persistGeneral = true;
  } else if (!strcmp(var, "tl_interval")) {
    tlInterval = constrain(v, 1, 3600);
    persistGeneral = true;
  } else if (!strcmp(var, "tl")) {
    if (v) {
      if (!sdOK) res = -1;
      else {
        tlCount = 0;
        tlRunning = true;
      }
    } else {
      tlRunning = false;
    }
  } else {
    res = -1;
  }

  if (res != 0) {
    httpd_resp_send_err(req, HTTPD_400_BAD_REQUEST,
                        "Setting not accepted");
    return ESP_FAIL;
  }

  if (persistGeneral) saveSettings();

  if (persistCamera) {
    prefs.putInt("framesize", (int)s->status.framesize);
    prefs.putInt("quality", s->status.quality);
    prefs.putInt("vflip", s->status.vflip);
    prefs.putInt("hmirror", s->status.hmirror);
  }

  httpd_resp_set_type(req, "text/plain");
  return httpd_resp_sendstr(req, "OK");
}

// ---------------- SD FILE BROWSER ----------------
esp_err_t listHandler(httpd_req_t *req) {
  if (!isAuthed(req)) return deny(req);

  char d[16] = "";
  getParam(req, "dir", d, sizeof(d));

  bool isTL = !strcmp(d, "timelapse");
  const char *dirName = isTL ? "timelapse" : "photos";
  const char *dirPath = isTL ? "/timelapse" : "/photos";

  if (!sdOK || sdLock == nullptr) {
    httpd_resp_send_err(req, HTTPD_500_INTERNAL_SERVER_ERROR,
                        "SD unavailable");
    return ESP_FAIL;
  }

  const int MAXN = 60;
  String names[MAXN];
  int total = 0;

  if (xSemaphoreTake(sdLock, pdMS_TO_TICKS(5000)) != pdTRUE) {
    httpd_resp_send_500(req);
    return ESP_FAIL;
  }

  File dir = SD_MMC.open(dirPath);

  if (dir && dir.isDirectory()) {
    File f = dir.openNextFile();

    while (f) {
      if (!f.isDirectory()) {
        const char *p = strrchr(f.name(), '/');
        p = p ? p + 1 : f.name();

        // Only list JPEG files generated for this project.
        if (strstr(p, ".jpg") != nullptr) {
          names[total % MAXN] = p;
          total++;
        }
      }

      f.close();
      f = dir.openNextFile();
    }

    dir.close();
  }

  xSemaphoreGive(sdLock);

  httpd_resp_set_type(req, "text/html; charset=utf-8");
  httpd_resp_set_hdr(req, "Cache-Control", "no-store");

  httpd_resp_sendstr_chunk(req,
    "<!doctype html><meta charset=utf-8>"
    "<meta name=viewport content='width=device-width,initial-scale=1'>"
    "<body style='font-family:ui-monospace,Consolas,monospace;"
    "background:#02100c;color:#7ff5cf;padding:12px'>"
    "<p><a style='color:#2effb8' href='/'>Back to camera</a></p>");

  char line[180];
  snprintf(line, sizeof(line),
           "<h3>%s (%d files%s)</h3><ul>",
           dirName, total, total > MAXN ? ", newest 60 shown" : "");

  httpd_resp_sendstr_chunk(req, line);

  int shown = 0;

  for (int k = total - 1; k >= 0 && shown < MAXN; k--, shown++) {
    const char *n = names[k % MAXN].c_str();

    // Generated filenames contain only letters, numbers, underscores and dots.
    snprintf(line, sizeof(line),
             "<li><a style='color:#2effb8' href='/file?d=%s&n=%s'>%s</a></li>",
             dirName, n, n);

    httpd_resp_sendstr_chunk(req, line);
  }

  httpd_resp_sendstr_chunk(req, "</ul></body>");
  return httpd_resp_sendstr_chunk(req, nullptr);
}

// Stream an SD file in chunks instead of allocating its full size in RAM.
esp_err_t fileHandler(httpd_req_t *req) {
  if (!isAuthed(req)) return deny(req);

  char d[16] = "";
  char n[48] = "";

  if (!getParam(req, "d", d, sizeof(d)) ||
      !getParam(req, "n", n, sizeof(n))) {
    httpd_resp_send_err(req, HTTPD_400_BAD_REQUEST,
                        "Missing file parameters");
    return ESP_FAIL;
  }

  const char *dir =
    !strcmp(d, "timelapse") ? "/timelapse" :
    !strcmp(d, "photos") ? "/photos" : nullptr;

  if (!dir) {
    httpd_resp_send_err(req, HTTPD_400_BAD_REQUEST,
                        "Invalid directory");
    return ESP_FAIL;
  }

  size_t nl = strlen(n);

  if (nl < 5 || strstr(n, "..") || strchr(n, '/') ||
      strchr(n, '\\') || strcmp(n + nl - 4, ".jpg") != 0) {
    httpd_resp_send_err(req, HTTPD_400_BAD_REQUEST,
                        "Invalid filename");
    return ESP_FAIL;
  }

  if (!sdOK || sdLock == nullptr ||
      xSemaphoreTake(sdLock, pdMS_TO_TICKS(5000)) != pdTRUE) {
    httpd_resp_send_500(req);
    return ESP_FAIL;
  }

  char path[96];
  snprintf(path, sizeof(path), "%s/%s", dir, n);

  File f = SD_MMC.open(path, FILE_READ);

  if (!f || f.isDirectory()) {
    if (f) f.close();
    xSemaphoreGive(sdLock);
    httpd_resp_send_404(req);
    return ESP_FAIL;
  }

  httpd_resp_set_type(req, "image/jpeg");
  httpd_resp_set_hdr(req, "Cache-Control", "no-store");

  uint8_t buffer[2048];
  esp_err_t result = ESP_OK;

  while (f.available()) {
    size_t count = f.read(buffer, sizeof(buffer));

    if (count == 0) break;

    result = httpd_resp_send_chunk(
      req, (const char *)buffer, count);

    if (result != ESP_OK) break;
    vTaskDelay(1);
  }

  f.close();
  xSemaphoreGive(sdLock);

  if (result == ESP_OK) {
    result = httpd_resp_send_chunk(req, nullptr, 0);
  }

  return result;
}

// ---------------- WEB SERVERS ----------------
void startServers() {
  httpd_config_t cfg = HTTPD_DEFAULT_CONFIG();

  cfg.server_port = 80;
  cfg.stack_size = 8192;
  cfg.max_uri_handlers = 14;
  cfg.lru_purge_enable = true;

  if (httpd_start(&mainServer, &cfg) == ESP_OK) {
    addUri(mainServer, "/", HTTP_GET, indexHandler);
    addUri(mainServer, "/auth", HTTP_GET, authHandler);
    addUri(mainServer, "/login", HTTP_POST, loginHandler);
    addUri(mainServer, "/logout", HTTP_GET, logoutHandler);
    addUri(mainServer, "/capture", HTTP_GET, captureHandler);
    addUri(mainServer, "/save", HTTP_GET, saveHandler);
    addUri(mainServer, "/status", HTTP_GET, statusHandler);
    addUri(mainServer, "/control", HTTP_GET, controlHandler);
    addUri(mainServer, "/list", HTTP_GET, listHandler);
    addUri(mainServer, "/file", HTTP_GET, fileHandler);
  } else {
    Serial.println("Failed to start control web server.");
  }

  cfg.server_port = 81;
  cfg.ctrl_port += 1;

  if (httpd_start(&streamServer, &cfg) == ESP_OK) {
    addUri(streamServer, "/stream", HTTP_GET, streamHandler);
  } else {
    Serial.println("Failed to start stream server.");
  }
}

// ---------------- BACKGROUND TASKS ----------------
void timelapseTick() {
  static uint32_t nextShot = 0;
  static int failures = 0;

  if (!tlRunning) {
    nextShot = 0;
    failures = 0;
    return;
  }

  uint32_t now = millis();

  if (nextShot != 0 && (int32_t)(now - nextShot) < 0) return;

  nextShot = now + tlInterval * 1000UL;

  char name[64];

  if (savePhoto("/timelapse", "tl", ++tlNum,
                name, sizeof(name))) {
    tlCount++;
    failures = 0;
    Serial.printf("Timelapse saved: %s\n", name);
  } else if (++failures >= 5) {
    Serial.println("Timelapse stopped after repeated save failures.");
    tlRunning = false;
  }
}

void autoLightTick() {
  static uint32_t nextCheck = 0;

  // Darkness detection runs only in Automatic mode. Mode = Off always stays off.
  bool detect = (lightMode == LIGHT_AUTO) ||
                (lightMode == LIGHT_OFF && DARK_LIGHT_IN_OFF_MODE);

  if (!detect) {
    nextCheck = 0;
    darkNow = false;
    applyLight();
    return;
  }

  if (!psramFound()) return;
  if (millis() - bootMillis < 3000UL) return;

  if (lightRecheck) {
    lightRecheck = false;
    nextCheck = 0;
  }

  uint32_t now = millis();

  if (nextCheck != 0 && (int32_t)(now - nextCheck) < 0) return;

  if (!darkNow) {
    int b = measureBrightness();
    lastBrightness = b;

    if (b >= 0 && b < darkThreshold) {
      darkNow = true;
      applyLight();
    }

    nextCheck = millis() + 5000UL;
  } else {
    // Turn the light off briefly to measure the room without it.
    writeFlashPWM(0);
    ledIsOn = false;
    delay(1500);

    int b = measureBrightness();
    lastBrightness = b;

    if (b >= 0 && b >= darkThreshold) darkNow = false;

    applyLight();
    nextCheck = millis() + 60000UL;
  }
}

// ---------------- SETUP ----------------
void setup() {
  Serial.begin(115200);
  delay(300);

  bootMillis = millis();
  Serial.println();
  Serial.println("Starting ESP32-CAM Control Station...");

  if (!strcmp(PANEL_PASS, "CHANGE_ME")) {
    Serial.println("WARNING: change PANEL_PASS at the top of the sketch.");
  }

  sdLock = xSemaphoreCreateMutex();

  if (sdLock == nullptr) {
    Serial.println("Warning: failed to create SD mutex.");
  }

  // Load saved configuration and increment the boot counter.
  loadSettings();

  bootNum = prefs.getUInt("boot", 0) + 1;
  prefs.putUInt("boot", bootNum);

  // Camera setup
  camera_config_t config = {};

  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer = LEDC_TIMER_0;

  config.pin_d0 = Y2_GPIO_NUM;
  config.pin_d1 = Y3_GPIO_NUM;
  config.pin_d2 = Y4_GPIO_NUM;
  config.pin_d3 = Y5_GPIO_NUM;
  config.pin_d4 = Y6_GPIO_NUM;
  config.pin_d5 = Y7_GPIO_NUM;
  config.pin_d6 = Y8_GPIO_NUM;
  config.pin_d7 = Y9_GPIO_NUM;

  config.pin_xclk = XCLK_GPIO_NUM;
  config.pin_pclk = PCLK_GPIO_NUM;
  config.pin_vsync = VSYNC_GPIO_NUM;
  config.pin_href = HREF_GPIO_NUM;
  config.pin_sccb_sda = SIOD_GPIO_NUM;
  config.pin_sccb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn = PWDN_GPIO_NUM;
  config.pin_reset = RESET_GPIO_NUM;

  config.xclk_freq_hz = 20000000;
  config.pixel_format = PIXFORMAT_JPEG;

  if (psramFound()) {
    config.frame_size = FRAMESIZE_SVGA;
    config.jpeg_quality = 10;
    config.fb_count = 2;
    config.fb_location = CAMERA_FB_IN_PSRAM;
    config.grab_mode = CAMERA_GRAB_LATEST;
    maxFrame = FRAMESIZE_UXGA;
  } else {
    config.frame_size = FRAMESIZE_CIF;
    config.jpeg_quality = 12;
    config.fb_count = 1;
    config.fb_location = CAMERA_FB_IN_DRAM;
    config.grab_mode = CAMERA_GRAB_WHEN_EMPTY;
    maxFrame = FRAMESIZE_VGA;
  }

  esp_err_t err = esp_camera_init(&config);

  if (err != ESP_OK) {
    Serial.printf("Camera initialization failed: 0x%x\n", err);
    Serial.println("Check the board model and camera ribbon cable.");
    delay(5000);
    ESP.restart();
  }

  sensor_t *sensor = esp_camera_sensor_get();

  if (sensor) loadCameraSettings(sensor);

  // Initialize storage and flash.
  initSD();
  initFlashPWM();
  applyLight();

  // Start the ESP32 access point.
  WiFi.mode(WIFI_AP);

  if (!WiFi.softAPConfig(apIP, apGateway, apSubnet)) {
    Serial.println("Warning: AP IP configuration failed.");
  }

  if (!WiFi.softAP(AP_SSID, AP_PASS, 1, 0, 4)) {
    Serial.println("Warning: Wi-Fi access point failed to start.");
  }

  WiFi.setSleep(false);

  startServers();

  Serial.println();
  Serial.println("==================================");
  Serial.println("ESP32-CAM is starting");
  Serial.print("Wi-Fi name: ");
  Serial.println(AP_SSID);
  Serial.print("Wi-Fi password: ");
  Serial.println(AP_PASS);
  Serial.print("Control panel: http://");
  Serial.println(WiFi.softAPIP());
  Serial.println("Stream: http://192.168.4.1:81/stream");
  Serial.println("==================================");

  delay(2000);
}

// ---------------- MAIN LOOP ----------------
void loop() {
  timelapseTick();
  autoLightTick();
  delay(20);
}
