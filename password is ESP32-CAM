// ---------------- FLASH LED COMPATIBILITY ----------------
void initFlashPWM() {
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcAttach(FLASH_PIN, 5000, 8);
#else
  ledcSetup(FLASH_CH, 5000, 8);
  ledcAttachPin(FLASH_PIN, FLASH_CH);
#endif
}

void writeFlashPWM(uint8_t duty) {
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcWrite(FLASH_PIN, duty);
#else
  ledcWrite(FLASH_CH, duty);
#endif
}

uint8_t wantedDuty() {
  if (lightMode == LIGHT_OFF) return 0;
  if (lightMode == LIGHT_ON) return lightLevel;

  if (lightMode == LIGHT_AUTO && darkNow) {
    return DARK_LIGHT_LEVEL;
  }

  return 0;
}

void applyLight() {
  uint8_t d = wantedDuty();
  writeFlashPWM(d);
  ledIsOn = (d > 0);
}

// ---------------- PERSISTENT SETTINGS ----------------
void loadSettings() {
  prefs.begin("camsettings", false);

  lightMode = prefs.getUChar("lightMode", LIGHT_AUTO);
  lightLevel = prefs.getUChar("lightLevel", 40);
  darkThreshold = prefs.getUChar("darkThr", 35);
  tlInterval = prefs.getUInt("tlInterval", 10);

  lightMode = constrain(lightMode, LIGHT_OFF, LIGHT_AUTO);
  lightLevel = constrain(lightLevel, 1, 255);
  darkThreshold = constrain(darkThreshold, 5, 120);
  tlInterval = constrain(tlInterval, 1, 3600);
}

void saveSettings() {
  prefs.putUChar("lightMode", lightMode);
  prefs.putUChar("lightLevel", lightLevel);
  prefs.putUChar("darkThr", darkThreshold);
  prefs.putUInt("tlInterval", tlInterval);
}

void loadCameraSettings(sensor_t *s) {
  int fs = prefs.getInt("framesize", -1);
  int quality = prefs.getInt("quality", 10);
  int vf = prefs.getInt("vflip", 0);
  int hm = prefs.getInt("hmirror", 0);

  if (fs >= FRAMESIZE_QVGA && fs <= maxFrame) {
    s->set_framesize(s, (framesize_t)fs);
  }
  s->set_quality(s, constrain(quality, 6, 40));
  s->set_vflip(s, vf ? 1 : 0);
  s->set_hmirror(s, hm ? 1 : 0);
}

