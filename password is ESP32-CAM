static bool getParam(httpd_req_t *req, const char *key,
                     char *out, size_t outLen) {
  char query[192];

  if (httpd_req_get_url_query_str(req, query, sizeof(query)) != ESP_OK)
    return false;

  return httpd_query_key_value(query, key, out, outLen) == ESP_OK;
}

static void addUri(httpd_handle_t h, const char *uri,
                   httpd_method_t method,
                   esp_err_t (*fn)(httpd_req_t *)) {
  httpd_uri_t u = {};
  u.uri = uri;
  u.method = method;
  u.handler = fn;
  u.user_ctx = nullptr;
  httpd_register_uri_handler(h, &u);
}

// ---------------- LOGIN HELPERS ----------------
// Returns the index of the matching session cookie, or -1.
static int findSession(httpd_req_t *req) {
  size_t len = httpd_req_get_hdr_value_len(req, "Cookie");
  if (len == 0 || len >= 200) return -1;

  char buf[200];
  if (httpd_req_get_hdr_value_str(req, "Cookie", buf, sizeof(buf)) != ESP_OK)
    return -1;

  const char *p = strstr(buf, "sid=");

  while (p) {
    bool startOk = (p == buf) || p[-1] == ' ' || p[-1] == ';';
    const char *v = p + 4;

    if (startOk && strnlen(v, TOKEN_LEN + 1) >= TOKEN_LEN &&
        (v[TOKEN_LEN] == '\0' || v[TOKEN_LEN] == ';' ||
         v[TOKEN_LEN] == ' ')) {
      for (int s = 0; s < MAX_SESSIONS; s++) {
        if (sessions[s][0] == '\0') continue;

        uint8_t diff = 0;
        for (int i = 0; i < TOKEN_LEN; i++) {
          diff |= (uint8_t)(v[i] ^ sessions[s][i]);
        }
        if (diff == 0) return s;
      }
    }

    p = strstr(p + 4, "sid=");
  }

  return -1;
}

static bool isAuthed(httpd_req_t *req) {
  return findSession(req) >= 0;
}

static void newSession(char *out) {
  uint32_t a = (uint32_t)random(0x7FFFFFFF) ^ (uint32_t)micros();
  uint32_t b = (uint32_t)random(0x7FFFFFFF) ^ (uint32_t)(millis() << 3);

  snprintf(out, TOKEN_LEN + 1, "%08x%08x", (unsigned)a, (unsigned)b);

  memcpy(sessions[sessionNext], out, TOKEN_LEN + 1);
  sessionNext = (sessionNext + 1) % MAX_SESSIONS;
}

static bool passOk(const char *in) {
  size_t a = strlen(in);
  size_t b = strlen(PANEL_PASS);
  uint8_t diff = (a != b) ? 1 : 0;

  for (size_t i = 0; i < b; i++) {
    char c = (i < a) ? in[i] : 0;
    diff |= (uint8_t)(c ^ PANEL_PASS[i]);
  }

  return diff == 0;
}

static uint32_t lockRemainSec() {
  if (!locked) return 0;

  uint32_t el = millis() - lockStart;

  if (el >= LOCK_MS) {
    locked = false;
    failCount = 0;
    return 0;
  }

  return (LOCK_MS - el + 999UL) / 1000UL;
}

static esp_err_t deny(httpd_req_t *req) {
  httpd_resp_set_status(req, "401 Unauthorized");
  httpd_resp_set_type(req, "text/plain");
  httpd_resp_sendstr(req, "Login required");
  return ESP_OK;
}

